	(text "Resistor network for FB:\n0.8(1+(47/13)) = 3.692 V output\n\nMCU: Imax = 300mA from datasheet\n\n△IL(max) = 500mA = 0.5A\nVout = 3.592V\nf=1.2MHz\nVin(max)=9V??\n\nL=(vout/(f * △IL(max)) * (1-(vout/vin(max)))\nL=(3.592/(1.2E6 * 0.5)) * (1-(3.592/9)) = 3.59 * 10^-6 \nL= ~3.6uH\n\n"
		(exclude_from_sim no)
		(at 15.748 156.718 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "84a99443-c939-40a5-9738-4f7aa5d12f49")
	)
